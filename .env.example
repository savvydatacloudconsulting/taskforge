# Copy this file to ".env" and edit it. NEVER commit the real .env (it is in .gitignore).
# TaskForge only needs a key when you use the live "api" backend; everything else works without any key.

# Which AI backend generate uses by default: claude | api | manual | replay
TASKFORGE_BACKEND=claude

# Only for --backend api (https://console.anthropic.com):
ANTHROPIC_API_KEY=your-api-key-here

# Optional model name for the claude / api backends (the backend's default is used when empty)
TASKFORGE_MODEL=
