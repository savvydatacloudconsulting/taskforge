+class CommandLimitError(RuntimeError):
+    """Raised if registering a command would exceed the ``max_commands``
+    limit of a group.
+
+    .. versionadded:: 8.5.0
+    """
+
+    command_name: t.Final[str]
+    limit: t.Final[int]
+
+    def __init__(self, command_name: str, limit: int) -> None:
+        message = _(
+            "Cannot add command {name!r}: the limit of {limit} commands has been"
+            " reached."
+        ).format(name=command_name, limit=limit)
+        super().__init__(message)
+        self.command_name = command_name
+        self.limit = limit
+
+
 class Abort(RuntimeError):
     """An internal signalling exception that signals Click to abort."""
 
